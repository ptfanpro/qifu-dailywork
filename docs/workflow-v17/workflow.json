{
  "version": 17,
  "mode": "manual-trigger-fast-path-with-confirmations",
  "timezone": "Asia/Shanghai",
  "dateModel": {
    "executionTimestamp": "E-in-Asia/Shanghai",
    "photoBusinessDate": "B_photo-explicit-actual-business-date",
    "pdfBusinessDate": "B_pdf-explicit-optional",
    "neverInferBusinessDateFromExecutionTime": true,
    "neverInferPdfDateFromPhotoDate": true
  },
  "photoBacklogDiscovery": {
    "scanOnInitialization": true,
    "sources": ["historical-photo-checkpoints", "pending-code-lists", "new-raw-images-in-business-date-folders"],
    "processOrder": "oldest-incomplete-business-date-first",
    "keepReceiptsSeparateByBusinessDate": true,
    "neverAssignLatePhotoToExecutionDate": true
  },
  "taskModes": {
    "combined": [
      "explicit-photo-business-date-processing-and-upload",
      "explicit-pdf-business-date-beijing-10am-gate",
      "explicit-pdf-business-date-export",
      "pdf-business-date-export-batch-offering-summary"
    ],
    "sameDayEveningPhotoOnly": [
      "same-day-actual-business-date-photo-processing-and-upload",
      "related-order-actions",
      "photo-result-verification-without-offering-summary",
      "stop-without-pdf-gate-or-export"
    ],
    "pdfOnly": [
      "explicit-pdf-business-date-beijing-10am-gate",
      "explicit-pdf-business-date-export"
    ]
  },
  "dates": {
    "businessFolderFormat": "M月D日",
    "internalWorkdayFolderFormat": "yyyy-MM-dd",
    "photoBusinessDateMustBeExplicit": true,
    "photoBusinessDateMayEqualExecutionCalendarDate": true,
    "photoBusinessDateMayBeEarlierThanExecutionCalendarDate": true,
    "pdfBusinessDateMustBeExplicitWhenPdfRequested": true,
    "pdfNotBeforeBeijingTime": "10:00:00",
    "pdfGateAppliesOnlyWhenTaskIncludesPdf": true,
    "eveningPhotoOnlyNeverAddsPdfAutomatically": true,
    "pdfDateToken": "month-and-day-without-zero-padding",
    "filterEndExclusiveDays": 1,
    "photoUploadCalendarDate": "year-month-from-printed-page-code"
  },
  "folderLayout": {
    "photoInput": "{businessRoot}/{photoBusinessMonth}月{photoBusinessDay}日/1",
    "processPhotosInPlace": true,
    "pdfOutput": "{businessRoot}/{pdfBusinessMonth}月{pdfBusinessDay}日",
    "photoInbox": "{businessRoot}/{businessMonth}月{businessDay}日/1",
    "internalState": "{machineLocalStateRoot}/workdays/{yyyy-MM-dd}",
    "machineLocalStateRootMustBeOutsideBusinessRoot": true,
    "nasAutomationFolderName": "@自动化处理",
    "neverCreateReadRestoreOrMigrateNasAutomationFolder": true,
    "runtimeStateExcludedFromMigrationPackage": true,
    "allowPhotoInboxToExistBeforePdf": true,
    "folderExistenceDoesNotProvePdfExport": true,
    "ensurePdfBusinessFolderAfterPdfSuccess": true,
    "preserveExistingPhotoInboxContents": true
  },
  "localStateCleanup": {
    "runAtFullInitialization": true,
    "minimumIntervalHours": 24,
    "rootBasenameMustEqual": "祈福运行数据",
    "mustResolveInsideMachineLocalStateRoot": true,
    "skipSymbolicLinks": true,
    "neverScanOrDeleteBusinessRoot": true,
    "neverDeleteUncommittedRollbackRequiredOrFailedTaskBackups": true,
    "committedPhotoPreparationEvidence": ["photo-prepare-receipt.completedAt", "photo-prepare-receipt.cleanupPending-is-empty"],
    "committedPhotoBackupRetentionDays": 7,
    "allowPurgingCommittedBatchWhileBusinessDateWaitsForLaterSupplement": true,
    "stagingAndQuarantineDeletionEvidence": ["scene-upload-receipt.complete", "scene-upload-receipt.tabletCompletionVerified", "scene-upload-receipt.completedAt-plus-7-days"],
    "staleTemporaryRetentionHours": 24,
    "temporaryCategories": ["pdf-download-temp", "photo-download-temp", "photo-ocr-crops", "pdf-code-crops"],
    "timingHistoryKeepPerCategory": 5,
    "keepReusableOcrModelCache": true,
    "cleanupReceiptContainsOnly": ["timestamp", "policy", "deleted-item-count", "deleted-bytes"],
    "cleanupFailurePolicy": "record-local-maintenance-error-without-changing-online-business-state-or-expanding-delete-scope"
  },
  "pdfShapeMatching": {
    "indexPdfsBeforePhotos": true,
    "indexStrategy": "first-last-page-count-plus-middle-anchors-then-full-scan-on-failure",
    "allowSequenceInferenceOnlyWhen": "last-minus-first-plus-one-equals-page-count-and-anchors-are-continuous",
    "singleOcrOutlierRepair": "only-when-all-other-pages-form-one-dense-unique-range-with-one-gap-and-one-character-confusion",
    "allowFabricatingMissingExportCodes": false,
    "readCodeFromFixedTopRightCrop": true,
    "numberingSource": "verified-pdf-page-index-located-by-staged-evidence",
    "evidencePriority": ["photo-digit-observation", "photo-text-signature", "pdf-page-shape-fingerprint"],
    "digitObservationIndependentFromFingerprint": true,
    "defaultMinDigitConfidence": 0.85,
    "maxDigitSupportedShapeRank": 1,
    "decisionRules": {
      "digitHighConfidenceUniqueInVerifiedRange": "accept-digit-page-without-fingerprint",
      "digitAmbiguousTextSignatureUnique": "accept-text-resolved-page",
      "digitAndTextAmbiguousFingerprintUnique": "accept-fingerprint-page",
      "evidenceConflict": "stop",
      "allEvidenceInsufficient": "stop"
    },
    "photoQuadOrder": ["top-left", "top-right", "bottom-right", "bottom-left"],
    "approximateQuadAutoRefinement": true,
    "quadRefinementSearchScope": "conservative-vertical-scale-and-shift-around-declared-quad",
    "quadRefinementIndependentFromDigitEvidence": true,
    "rectificationScoreAggregation": "0.8-best-plus-0.2-mean-of-top-k",
    "defaultRectificationTopK": 3,
    "disableRefinementFlag": "--no-quad-refinement",
    "defaultMinScore": 0.35,
    "defaultMinMargin": 0.05,
    "runFingerprintOnlyForAmbiguousPhotos": true,
    "allowTwoAdjacentSameTemplateAnchorsToExtendUniqueSequence": true,
    "portraitExactRemainderRule": "same-color-portrait-only-equal-photo-and-page-count-no-strong-conflict-and-pdf-batch-capture-order",
    "identifyCandidatePdfBeforePageMatching": true,
    "requireAssignedPageToBeLocalBest": true,
    "crossCheckExistingNumericFilenameClaimByDefault": false,
    "optionalMigrationFilenameAuditFlag": "--check-existing-numeric-filenames",
    "requireUniquePhotoToPageMapping": true,
    "detectDuplicatePageAssignments": true,
    "detectMissingExpectedPages": true,
    "missingPhotoPolicy": "record-pending-codes-and-continue-safe-matches",
    "missingPhotosDoNotBlockRenameOrUpload": true,
    "allowExistingFilenameAsEvidence": false,
    "stopOnLowConfidenceOrConflict": true,
    "manualReviewOnlyForNonUniqueOrIncompleteShapeEvidence": true,
    "defaultRenameMode": "dry-run"
  },
  "blessingImage": {
    "platform": 1,
    "maxUploadBatch": 50,
    "preferredWidthPx": 1800,
    "keepAspectRatio": true,
    "targetAspectRatio": "4:3-approximate",
    "jpegQuality": 9,
    "maxBytes": 1572864,
    "manualReviewForCropOrBlackBorder": true,
    "preserveLeadingZero": false,
    "renameFromFullCode": "last-segment",
    "incrementalSupplementMode": true,
    "skipExistingNumericOutputsOnSupplement": true,
    "uploadReceiptIdentity": "basename-plus-sha256",
    "uploadResultMessageSources": ["native-dialog", "explicit-message-layer"],
    "ignoreUploadResultSources": ["control-script", "generic-dialog-full-text", "hidden-dom"],
    "uploadCountDecision": "accept-expected-batch-count-if-present-in-explicit-numeric-messages-ignore-page-cumulative-count",
    "legacyCompleteReceiptMigration": "only-when-file-set-hash-and-uploaded-count-both-match-then-fill-per-file-sha256",
    "recognizeOnlyNewRawImagesOnSupplement": true
  },
  "historicalSupplement": {
    "allowOldPdfOriginalCodes": true,
    "allowReexportedPdfNewCodes": true,
    "reexportPdfBelongsToOriginalBusinessDate": true,
    "onlineClosureFilter": "original-photo-business-date-and-blessing-image-not-uploaded",
    "allowSupersedingOldPendingCodesOnlyWhen": [
      "new-file-upload-receipts-verified",
      "online-not-uploaded-count-is-zero-for-original-business-date"
    ],
    "neverUseExecutionDateForOrderCompletion": true,
    "sceneImageBusinessDate": "original-photo-business-date",
    "neverUseExecutionDateSceneImages": true
  },
  "sceneImages": {
    "renewDaily": true,
    "classifyByVisualContent": true,
    "neverForceFourCandidatesIntoTwoLampAndTwoWater": true,
    "sceneAmbiguityMustNotCreateBlessingNumberClaims": true,
    "sourceDirectory": "{businessRoot}/{photoBusinessMonth}月{photoBusinessDay}日/1",
    "requireExactPhotoBusinessDateDirectory": true,
    "rejectExecutionDateOrOtherDateSceneImages": true,
    "stopWhenOriginalBusinessDateSceneImagesMissing": true,
    "pathVerificationMoments": ["before-browser-open", "immediately-before-file-selection"],
    "rejectSymlinkOutsideExpectedDirectory": true,
    "receiptEvidence": ["photo-business-date", "real-photo-directory", "filename", "sha256"],
    "waterProductExactName": "供水养净",
    "allOtherProducts": "供灯",
    "lampFilenames": ["2.1.jpg", "2.2.jpg"],
    "waterFilenames": ["2.5.jpg", "2.6.jpg"],
    "stopIfCategoryHasMoreThanTwo": true
  },
  "orderProcessing": {
    "photoUploadHasNoTimePrerequisite": true,
    "allowPartialVerifiedBlessingUpload": true,
    "blockSceneAndBatchCompletionUntilAllExpectedPhotosArrive": false,
    "allowPartialOrderCompletionForUploadedBlessingImages": true,
    "partialCompletionFilter": ["original-photo-business-date", "blessing-image-uploaded", "order-still-processable"],
    "leaveNotUploadedOrdersPending": true,
    "partialCompletionReceiptIdentity": "photo-file-set-sha256-plus-order-id-hash",
    "wholeBusinessDateCompleteOnlyWhenOnlineNotUploadedZero": true,
    "allowReexportClosureWithLocalOldCodesPending": true,
    "requireOriginalBusinessDateOnlineNotUploadedZeroForReexportClosure": true,
    "filterOrdersByPhotoBusinessDate": true,
    "blessingImageStatus": "已上传",
    "processWaterFirst": true,
    "completeOnlyAfterSceneUploadVerified": true,
    "verificationScope": "explicit-photo-business-date-and-uploaded-blessing-image",
    "finalStatusButton": "批量修改福单状态",
    "uploadFileChooser": "arm-before-click-then-set-absolute-files",
    "autoAcceptAuthorizedUploadDialogs": true,
    "maxImmediateDialogs": 2,
    "verifyAfterDialog": true
  },
  "browserExecution": {
    "reuseOneLongLivedSessionPerPhase": true,
    "pageSize": 1000,
    "useHeaderSelectAll": true,
    "neverClickRowsOneByOne": true,
    "waitForSpecificStateNotNetworkIdle": true,
    "avoidRepeatedFullDomSnapshots": true,
    "avoidRepeatedValidationWhenStateUnchanged": true,
    "downloadDetection": "new-file-in-download-directory",
    "acceptCompleteCrdownloadAsPdfWhen": ["magic-%PDF-", "has-%%EOF", "strict-pypdf-parse"],
    "doNotWaitForBrowserDownloadCompletionEvent": true
  },
  "performance": {
    "intent": "normal-work-must-be-materially-faster-than-skilled-human-20-to-30-minutes",
    "targetsSeconds": {
      "photo-only": 600,
      "pdf-only": 360,
      "combined": 900
    },
    "warningRatio": 0.8,
    "onThreshold": "stop-new-same-class-retries-finish-only-safe-cleanup-and-report",
    "timingScript": "scripts/track_workflow_timing.py",
    "requiredArtifacts": ["timing.json", "timing-audit.json"],
    "requiredPhases": [
      "date-resolution",
      "pdf-index",
      "photo-match",
      "photoshop",
      "upload",
      "order-processing",
      "pdf-query",
      "pdf-export",
      "pdf-finalize",
      "tablet-renewal",
      "quantity"
    ],
    "requiredCounters": [
      "photo_count",
      "pdf_page_count",
      "export_order_count",
      "digit_direct_count",
      "text_resolved_count",
      "fingerprint_fallback_count",
      "manual_review_count",
      "browser_action_count",
      "browser_reconnect_count",
      "full_dom_snapshot_count",
      "filechooser_manual_takeover_count",
      "dialog_manual_takeover_count",
      "download_event_wait_count",
      "download_directory_watch_count",
      "retry_count",
      "duplicate_validation_count",
      "user_intervention_count"
    ],
    "hardExpectations": {
      "browserInitializationCount": 1,
      "filechooserManualTakeoverCount": 0,
      "dialogManualTakeoverForAuthorizedUploadOrExport": 0,
      "downloadEventWaitCount": 0,
      "duplicateValidationCount": 0
    },
    "auditMustSeparate": [
      "business-system-wait",
      "browser-control-wait",
      "local-compute",
      "human-wait",
      "duplicate-work"
    ],
    "privacy": "timing-and-counts-only-no-customer-order-content-credentials-cookies-photos-or-login-state",
    "continuousImprovement": "after-three-stable-runs-update-rules-increment-version-retest-and-repackage"
  },
  "sessionKeepalive": {
    "activeTaskOnly": true,
    "idleIntervalMinutes": 5,
    "useSeparateReadOnlyTab": true,
    "safeRequest": "reload-main-or-read-only-page",
    "neverRefreshUnsavedForm": true,
    "stopAtTaskPauseOrCompletion": true,
    "onLogout": "stop-and-require-user-login",
    "storeCredentials": false
  },
  "quantityAccounting": {
    "runAfterPdfExport": true,
    "source": "unique-order-manifest-included-in-final-pdfs-for-explicit-pdf-business-date",
    "collectionScope": "B_pdf-final-export-batch-only",
    "excludePhotoProcessingAndOperationDayRecords": true,
    "excludeDuplicateDownloadsAndReexports": true,
    "deduplicateByOrderId": true,
    "defaultFormula": "singleQuantity-times-quantity",
    "bundleCountFromProductName": true,
    "bundleCountPattern": "(\\d+)盏",
    "knownBundleFamilies": ["佛缘灯", "莲花灯"],
    "physicalProductAliases": {
      "9元灯": ["莲花灯", "莲花祈福灯", "往生灯", "往生极乐灯"],
      "佛缘灯": ["佛缘灯", "佛缘祈福灯"]
    },
    "venueMessage": {
      "opening": "师兄 今天",
      "lines": [
        {"label": "9元灯", "physicalGroup": "9元灯", "unit": "盏"},
        {"label": "3元灯", "physicalGroup": "吉祥祈福灯", "unit": "盏"},
        {"label": "1元灯", "physicalGroup": "佛缘灯", "unit": "盏"},
        {"label": "供水", "physicalGroup": "供水养净", "unit": "份"}
      ],
      "closing": "辛苦您",
      "format": "label-plus-number-plus-unit-without-spaces-or-parenthetical-text"
    },
    "retainCalculationDetails": true
  },
  "tabletManagement": {
    "doNotTrustSidebarCountAlone": true,
    "pendingFilter": "待祈福",
    "startDateFilter": "B_pdf",
    "redProduct": "长生禄位",
    "yellowProduct": "往生莲位",
    "templates": {"red": "长生位模板", "yellow": "往生位模板"},
    "requiresSceneImage": false,
    "completeAfterReturnedBlessingImageVerified": true
  },
  "renewalManagement": {
    "scope": "expired-tablets-with-renewal-only",
    "pendingFilter": "未处理",
    "terminalStatus": "续费已处理终态",
    "terminalStatusUiLabels": ["延续已处理", "代理已处理", "已处理"],
    "terminalDialogModes": ["direct-confirm", "select-option"],
    "directConfirmMustMatch": "批量修改成-(延续|代理)?-已处理状态",
    "selectOptionScope": "visible-renewal-dialog-only",
    "neverUsePageFilterSelectAsDialogControl": true,
    "unrecognizedDialogPolicy": "stop-without-submit",
    "terminalRecordsLeaveFutureWork": true,
    "templates": {"red": "长生位模板", "yellow": "往生位模板"},
    "pdfNaming": {
      "seriesSharedAcrossAllDailyBusinessModulesByPaperColor": true,
      "useNextAvailableSuffix": true,
      "preventOverwrite": true
    },
    "returnedPhotoMatching": "pdf-page-shape-then-last-code-segment",
    "manualConfirmationBeforeStatusChange": false,
    "standingAuthorizationAfterVerifiedPdf": true,
    "autoChangeToTerminalStatusAfterPdfVerified": true,
    "verificationBeforeAutoChange": ["pdf-structure", "page-count", "file-sha256", "original-pending-order-id-hash", "current-pending-order-id-hash-equals-original"],
    "explicitlySelectTerminalStatus": true,
    "verifyOriginalOrderIdsAbsentAfterStatusChange": true,
    "receiptIncludes": ["terminal-ui-label", "dialog-mode"],
    "newOrdersArrivingDuringStatusChange": "leave-pending-for-next-export-batch",
    "onStatusChangeFailure": "preserve-verified-pdf-and-order-hash-then-resume-status-change-only",
    "neverRepeatPdfExportForStatusChangeFailure": true,
    "verifyMatchedAndReplacedCounts": true
  },
  "pdf": {
    "pageSize": 1000,
    "selectAllScope": "current-page",
    "mergePageFragments": true,
    "waterFilenameSuffix": "供水",
    "paperSeries": {
      "red": ["ordinary_red", "tablet_red"],
      "yellow": ["ordinary_yellow", "tablet_yellow"]
    },
    "numbering": "sequential-among-existing-merged-groups",
    "tabletTemplates": {"red": "长生位模板", "yellow": "往生位模板"},
    "newOrderFilterMustIncludeState": "待祈福",
    "excludeEarlyCompletedFutureOrders": true,
    "saveExactOrderIdManifestBeforeStateChange": true,
    "fragmentValidationOnce": ["magic", "eof", "strict-parse", "page-count"],
    "finalValidation": ["source-page-sum", "final-page-count", "first-code", "last-code", "copy-sha256"]
  },
  "manualCheckpoints": [
    "pdf-code-not-readable",
    "fingerprint-and-high-confidence-digit-conflict",
    "both-numbering-evidence-insufficient",
    "duplicate-or-missing-photo-page",
    "crop-or-black-border-needed",
    "upload-count-mismatch",
    "before-batch-complete",
    "before-batch-blessing-status-change",
    "before-old-photo-replacement",
    "before-sending-pdfs"
  ]
}
