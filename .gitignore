# Dependencies and build output
node_modules/
dist/
build/
__pycache__/
*.py[cod]
*.zip
*.7z

# V9.6 portable OCR runtime is a reviewed release asset. Keep these exceptions
# after the generic build-output rules so tagged snapshots remain executable on
# another Windows x64 computer without downloading Node native dependencies.
!vendor/
!vendor/onnxruntime-node/
!vendor/onnxruntime-node/dist/
!vendor/onnxruntime-node/dist/**
!vendor/onnxruntime-node/node_modules/
!vendor/onnxruntime-node/node_modules/onnxruntime-common/
!vendor/onnxruntime-node/node_modules/onnxruntime-common/**
vendor/onnxruntime-node/dist/*.d.ts
vendor/onnxruntime-node/dist/*.map
vendor/onnxruntime-node/node_modules/onnxruntime-common/README.md
vendor/onnxruntime-node/node_modules/onnxruntime-common/dist/esm/
vendor/onnxruntime-node/node_modules/onnxruntime-common/lib/
vendor/onnxruntime-node/node_modules/onnxruntime-common/dist/cjs/*.d.ts
vendor/onnxruntime-node/node_modules/onnxruntime-common/dist/cjs/*.map

# Machine-local settings and runtime state
data/
祈福运行数据/
tmp/
runtime/
workdays/
browser-profile/
playwright-profile/

# Credentials, environment files and browser/session material
.env
.env.*
!.env.example
*.cookie*
*storage-state*.json
*auth-state*.json
secure-login.dat
*credential*.dat
secure-automation.dat

# Business data and generated evidence must never enter source control
*.log
timing.json
timing-audit.json
photo-*-receipt.json
scene-*-receipt.json
order-manifest.json
*.crdownload
*.pdf

# Local diagnostics and screenshots
diagnostics/
body-observation-cache/
screenshots/
*.png
*.jpg
*.jpeg
*.webp

# The compressed OCR model in ocr-data is an intentional source asset.
!ocr-data/
!ocr-data/eng.traineddata.gz
eng.traineddata

# OS/editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
